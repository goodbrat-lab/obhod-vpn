{
  "luci-app-obhod": {
    "description": "Grant UCI and RPC access to LuCI app obhod",
    "read": {
      "file": {
        "/etc/init.d/obhod": [
          "exec"
        ],
        "/usr/bin/obhod": [
          "exec"
        ]
      },
      "ubus": {
        "service": [
          "list"
        ]
      },
      "uci": [
        "obhod"
      ]
    },
    "write": {
      "uci": [
        "obhod"
      ]
    }
  }
}