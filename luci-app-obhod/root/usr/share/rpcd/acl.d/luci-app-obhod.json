{
  "luci-app-obhod": {
    "description": "Obhod VPN configuration access",
    "read": {
      "file": {
        "/etc/config/obhod": [ "read" ],
        "/usr/bin/obhod": [ "exec" ],
        "/usr/lib/obhod/obhod-backend.sh": [ "exec" ],
        "/etc/init.d/obhod": [ "exec" ],
        "/tmp/sing-box/config.json": [ "read" ],
        "/tmp/obhod_backup.tar.gz": [ "read" ]
      },
      "ubus": {
        "uci": [ "get", "sections" ],
        "service": [ "list", "status" ],
        "system": [ "info" ]
      },
      "uci": [ "obhod" ]
    },
    "write": {
      "file": {
        "/etc/config/obhod": [ "write" ]
      },
      "ubus": {
        "uci": [ "set", "add", "delete", "commit" ]
      },
      "uci": [ "obhod" ]
    }
  }
}
