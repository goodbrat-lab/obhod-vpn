{
	"luci-app-obhod": {
		"description": "Grant access to Obhod VPN",
		"read": {
			"cgi-bin": [ "luci/admin/services/obhod/*" ],
			"uci": [ "obhod" ],
			"ubus": {
				"uci": [ "get", "sections" ],
				"file": [ "read", "list" ]
			}
		},
		"write": {
			"cgi-bin": [ "luci/admin/services/obhod/*" ],
			"uci": [ "obhod" ],
			"ubus": {
				"uci": [ "set", "add", "delete", "commit" ],
				"file": [ "write" ]
			}
		}
	}
}