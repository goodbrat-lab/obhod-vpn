{
  "luci-app-obhod": {
    "description": "Grant full access to Obhod VPN services",
    "read": {
      "cgi-bin": [ "/usr/bin/obhod" ],
      "file": {
        "/etc/config/obhod": [ "read" ],
        "/usr/bin/obhod": [ "exec" ],
        "/usr/lib/obhod/obhod-backend.sh": [ "exec" ],
        "/etc/init.d/obhod": [ "exec" ],
        "/sbin/logread": [ "exec" ],
        "/usr/bin/dig": [ "exec" ],
        "/tmp/sing-box/config.json": [ "read" ],
        "/tmp/obhod_backup.tar.gz": [ "read" ]
      },
      "ubus": {
        "file": [ "exec", "read", "list" ],
        "uci": [ "get", "sections" ],
        "service": [ "list", "status" ],
        "system": [ "info", "log" ]
      },
      "uci": [ "obhod" ]
    },
    "write": {
      "file": {
        "/etc/config/obhod": [ "write" ]
      },
      "ubus": {
        "uci": [ "set", "add", "delete", "commit" ],
        "file": [ "write" ]
      },
      "uci": [ "obhod" ]
    }
  }
}
