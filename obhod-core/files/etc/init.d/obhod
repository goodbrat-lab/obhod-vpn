#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC2154

START=99
STOP=10
USE_PROCD=1

PROG_DAEMON=/usr/bin/obhoud
PROG_MAIN=/usr/bin/obhod

script=$(readlink "$initscript")
NAME="$(basename ${script:-$initscript})"

start_service() {
    echo "Starting Obhod..."
    config_load "$NAME"

    local enabled
    config_get_bool enabled settings enabled 0
    if [ "$enabled" -eq 0 ]; then
        echo "Obhod is disabled in /etc/config/obhod. Set 'option enabled 1' to enable."
        return 0
    fi

    # Step 1: One-shot setup — WAN wait, nft rules, sing-box config, dnsmasq.
    # This script runs, configures everything, and exits.
    "$PROG_MAIN" start_main
    local ret=$?
    if [ "$ret" -ne 0 ]; then
        echo "Obhod core setup failed (exit code $ret). Check logread for details."
        return "$ret"
    fi

    # Step 2: Register the Go watchdog daemon with procd.
    local log_level
    config_get log_level settings log_level "info"

    procd_open_instance "watchdog"
    procd_set_param command "$PROG_DAEMON" -log-level "$log_level" watchdog -interval 30s
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    echo "Stopping Obhod..."
    # Teardown nft rules, routes, sing-box, restore dnsmasq.
    # The procd watchdog instance is killed automatically before this runs.
    "$PROG_MAIN" stop_main
}

reload_service() {
    "$PROG_MAIN" reload > /dev/null 2>&1
}

service_triggers() {
    config_load "$NAME"

    local enable_badwan enable_ifaces delay
    config_get_bool enable_badwan settings enable_badwan_interface_monitoring 0
    config_get enable_ifaces settings badwan_monitored_interfaces ""
    config_get delay settings badwan_reload_delay "2000"

    PROCD_RELOAD_DELAY=$delay

    procd_open_trigger
    procd_add_config_trigger "config.change" "$NAME" "$initscript" restart

    if [ "$enable_badwan" = "1" ] && [ -n "$enable_ifaces" ]; then
        for iface in $enable_ifaces; do
            procd_add_interface_trigger "interface.*.up" "$iface" /etc/init.d/obhod reload
        done
    fi
    procd_close_trigger
}
