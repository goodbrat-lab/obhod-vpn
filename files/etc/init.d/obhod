#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG_DAEMON=/usr/bin/obhoud
PROG_MAIN=/usr/bin/obhod

start_service() {
    config_load obhod
    local enabled
    config_get_bool enabled settings enabled 0

    if [ "$enabled" -eq 0 ]; then
        echo "Obhod is disabled in /etc/config/obhod"
        return 0
    fi

    # Step 1: Run the full setup (nft rules, sing-box config, dnsmasq, etc.)
    # This is a one-shot setup script, not a long-running process.
    echo "Running Obhod core setup..."
    "$PROG_MAIN" start_main
    local ret=$?
    if [ "$ret" -ne 0 ]; then
        echo "Obhod core setup failed with code $ret. Service will not start."
        return "$ret"
    fi

    # Step 2: Register the Go watchdog daemon with procd for lifecycle management.
    # procd will restart it automatically if it crashes.
    echo "Starting obhoud watchdog daemon..."
    procd_open_instance "watchdog"
    procd_set_param command "$PROG_DAEMON" watchdog -interval 30s
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    echo "Stopping Obhod..."
    # Teardown: flush nft rules, routes, stop sing-box, restore dnsmasq.
    # The procd watchdog instance is killed automatically by procd.
    "$PROG_MAIN" stop_main
}

reload_service() {
    stop_service
    start_service
}

service_triggers() {
    procd_add_reload_trigger "obhod"
}
