config obhod 'settings'
    # Enable or disable the obhod service (0 = disabled, 1 = enabled)
    option enabled '1'

    # Log level for sing-box and obhod (debug, info, warn, error, fatal)
    option log_level 'info'

    # How often to update remote domain/subnet lists
    option update_interval '1d'

    # Set to 1 to prevent obhod from modifying /etc/config/dhcp (dnsmasq).
    option dont_touch_dhcp '0'

    # Internal flag: tracks whether last shutdown was clean.
    option shutdown_correctly '1'

    # Path to sing-box configuration file written by obhod
    option config_path '/etc/sing-box/config.json'

    # Source network interfaces to route through the tunnel (space-separated)
    option source_network_interfaces 'br-lan'

    # Whether to exclude NTP traffic (UDP port 123) from the proxy (0/1)
    option exclude_ntp '0'

config obhod 'dashboard'
    # This section is required for the LuCI dashboard to render correctly.
    # It stores UI preferences and temporary state.

config section 'main'
    # Default tunnel configuration.
    option connection_type 'proxy'
    option proxy_config_type 'url'
    option proxy_string ''
    option enabled '1'
    list community_lists 'russia_outside'
    list community_lists 'youtube'
    list community_lists 'discord'

# ==========================================================================
# Supported proxy_config_type values:
#   url         — single proxy URL (vless://, ss://, etc.)
#   subscription — subscription URL returning a list of proxy links
#   urltest     — multiple links, auto-selects fastest
#   selector    — multiple links, manual selection via dashboard
#   outbound    — raw sing-box outbound JSON
# ==========================================================================
